# App Configuration
PORT=3001
JWT_SECRET=replace-with-a-long-random-string-min-10-chars
APP_URL=http://localhost:5173

# Initial Admin (used on first run only)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# Database
DB_PATH=./data/sqlite.db

# Docs (prompts/schemas) — optional, defaults to repo ./docs
# DOCS_DIR=./docs

# AI
GOOGLE_AI_API_KEY=your_gemini_api_key_here

# Logging — optional, defaults to info
# LOG_LEVEL=info

# Transactional Email — Resend (mandatory provider)
RESEND_API_KEY=re_your_resend_api_key_here
MAIL_FROM=Abstract ETL <abstract@builtnetworks.com>

# Stripe Billing (Track 5) - use TEST keys to start
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_SOLO=price_...
# STRIPE_PRICE_TEAM=price_...
# STRIPE_PRICE_ENTERPRISE=price_...
